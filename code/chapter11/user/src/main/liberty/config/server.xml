<?xml version="1.0" encoding="UTF-8"?>
<server description="MicroProfile User Service Server">

    <featureManager>
        <platform>microProfile-7.1</platform>
        <platform>jakartaEE-10.0</platform>
        <feature>restfulWS</feature>
        <feature>jsonp</feature>
        <feature>jsonb</feature>
        <feature>cdi</feature>
        <feature>beanValidation</feature>
        <feature>mpOpenAPI</feature>
    </featureManager>

    <httpEndpoint httpPort="6050" httpsPort="6051"
                  id="defaultHttpEndpoint" host="*" />

    <webApplication location="user.war" contextRoot="${app.context.root}"/>
</server>
